# Port the server listens on (Passenger on cPanel sets this automatically)
PORT=3001

# The email address all form submissions get delivered to
TO_EMAIL=yourshop@gmail.com

# ── Option A: Gmail (easiest) ──────────────────────────────────────────────
# 1. Enable 2-Step Verification on the Google account
# 2. Go to Security → App passwords → create one
# 3. Paste the 16-char app password below (spaces are fine)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourshop@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Option B: Namecheap cPanel email (if you have hosting email set up) ───
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your-cpanel-email-password

# Frontend origin for CORS — localhost for dev, your real domain in production
CORS_ORIGIN=http://localhost:5173
